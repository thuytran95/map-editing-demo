{
  "name": "map-editing-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Project minh họa kỹ thuật front-end biên tập dữ liệu bản đồ (ReactJS + OpenLayers + Jotai + Material UI + Node.js API) - Báo cáo thực tập tốt nghiệp Trần Thu Thủy",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "client": "vite",
    "seed": "node server/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^5.16.7",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jotai": "^2.10.1",
    "ol": "^9.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
